# Example env for running the backend without varlock / Proton Pass.
# Copy to .env and adjust. The source of truth is .env.schema.

# dev | ci | build | prod
APP_MODE=dev
IS_PROD=false

## Ports
PORT=8000
LLM_API_PORT=9000
CLIENT_PORT=3000
WHISPER_PORT=50001

## URLs
CLIENT_URL=http://localhost:${CLIENT_PORT}
LLM_URL=http://localhost:${LLM_API_PORT}/v1
LLM_HEALTH_CHECK_URL=http://localhost:${LLM_API_PORT}/health
WHISPER_URL=http://localhost:${WHISPER_PORT}/v1
WHISPER_HEALTH_CHECK_URL=http://localhost:${WHISPER_PORT}/readyz

## LLM
LLM_MODEL=Gemma/Gemma-4-31B
LLM_API_KEY=none

## Secrets
# Used to pseudonymize user ids. Create with: openssl rand 32 | base64
HMAC_SECRET="YOUR HMAC SECRET"

## Optional
# Maximum upload size in bytes (default 2 GiB)
# MAX_UPLOAD_BYTES=2147483648
# Only needed for the vLLM docker container
# HF_TOKEN=
