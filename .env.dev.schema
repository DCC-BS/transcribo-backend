# Dev-only variables (Proton Pass secrets)
#
# Loaded only when APP_MODE=dev (see the @import in .env.schema). This keeps
# the proton-pass plugin and its protonPass() resolver calls out of the
# production build, so varlock never has to fetch the plugin from npm at
# runtime and prod secrets are never resolved here.
# @plugin(@varlock/proton-pass-plugin@0.0.3)
# @initProtonPass()
# @defaultRequired=true @defaultSensitive=false
# ---

# only needed for the VLLM docker container
# @optional @sensitive
HF_TOKEN=protonPass("pass://DCC-KI/HUGGING_FACE_TOKEN/TOKEN", allowMissing=true)
